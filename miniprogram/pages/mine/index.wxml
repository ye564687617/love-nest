<import src="../../templates/visual.wxml"/>
<template is="background"/>
<view class="page"><view class="page-banner"><view class="title">我们的小窝</view><view class="subtitle">两个人的生活，也欢迎你来看看。</view><view class="banner-divider">✿</view></view>
<view wx:if="{{loading}}" class="skeleton"></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
<block wx:if="{{!loading && !error}}"><view wx:if="{{owner}}" class="auth-panel"><view class="auth-logo"><image src="/assets/heart-white.png"/></view><view class="section-title">{{nickname}}，欢迎回家</view><view class="actions"><button wx:if="{{canMoments}}" class="primary" data-module="moments" bindtap="edit">记录瞬间</button><button wx:if="{{canChecklist}}" data-module="lovelist" bindtap="edit">添加心愿</button><button wx:if="{{canDays}}" data-module="countdowns" bindtap="edit">添加纪念日</button><button bindtap="logout">退出登录</button></view></view>
<view wx:else class="auth-panel"><view class="auth-logo"><image src="/assets/heart-white.png"/></view><view class="auth-heading">主人登录</view><view class="field"><text class="label">账号</text><input value="{{username}}" data-field="username" bindinput="input" maxlength="30" placeholder="网站管理账号"/></view><view class="field"><text class="label">密码</text><input password value="{{password}}" data-field="password" bindinput="input" maxlength="128" placeholder="请输入密码"/></view><view class="field"><text class="label">验证码</text><view class="row"><input value="{{captchaText}}" data-field="captchaText" bindinput="input" maxlength="8" placeholder="图中字符"/><image wx:if="{{captchaImage}}" class="captcha" src="{{captchaImage}}" bindtap="refreshCaptcha" mode="aspectFit"/><button wx:else class="small" bindtap="refreshCaptcha" loading="{{captchaLoading}}" disabled="{{captchaLoading || submitting}}">加载验证码</button></view></view><view wx:if="{{formError}}" class="error form-error">{{formError}}</view><button class="primary" bindtap="login" loading="{{submitting}}" disabled="{{submitting || captchaLoading}}">回到小窝</button></view></block>
<view class="section"><view class="section-title feature-heading">小窝时光</view><view class="feature-list"><button data-page="music" bindtap="openFeature"><image src="/assets/music.png"/><text>我们的歌单</text><text class="muted">→</text></button><button wx:if="{{owner}}" data-page="chat" bindtap="openFeature"><image src="/assets/chat.png"/><text>两人私信</text><text class="muted">→</text></button><button data-page="games" bindtap="openFeature"><image src="/assets/games.png"/><text>情侣小游戏</text><text class="muted">→</text></button></view></view>
<view wx:if="{{formError && owner}}" class="error">{{formError}}</view></view>
