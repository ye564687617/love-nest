.captcha { width:220rpx; height:92rpx; flex-shrink:0; }
.auth-panel { padding:36rpx; border:1rpx solid rgba(255,107,139,.15); background:rgba(255,255,255,.96); border-radius:32rpx; box-shadow:0 12rpx 40rpx rgba(255,107,139,.12); }
.auth-logo { width:88rpx; height:88rpx; margin:0 auto 20rpx; padding:22rpx; border-radius:24rpx; background:linear-gradient(135deg,#ff6b8b,#ff8e53); }
.auth-logo image { width:100%; height:100%; }
.auth-heading { text-align:center; font-size:36rpx; font-weight:600; }
.auth-panel .field { margin:24rpx 0; }
.auth-panel input { background:#faf8f9; min-width:0; }
.auth-panel .row > input { flex:1; width:0; }
.auth-panel .primary { width:100%; }
.auth-panel .actions button { flex:1 1 40%; }
.auth-panel .actions .primary { width:auto; }
.form-error { padding:16rpx; margin:0 0 24rpx; font-size:24rpx; }
.feature-heading { color:#5d4037; margin-left:8rpx; }
.feature-list { display:flex; flex-direction:column; gap:16rpx; }
.feature-list button { display:flex; align-items:center; gap:20rpx; text-align:left; border-radius:24rpx; padding:28rpx; color:#5d4037; background:rgba(255,255,255,.92); }
.feature-list image { width:44rpx; height:44rpx; }
.feature-list text:first-of-type { flex:1; }
