<import src="../../templates/visual.wxml"/>
<template is="background"/>
<view class="page">
  <view class="page-banner"><view class="title">两人私信</view><view wx:if="{{partner}}" class="subtitle">与 {{partner}} 的对话</view><view class="banner-divider">✿</view></view>
  <view wx:if="{{loading}}" class="skeleton"></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="start">重试</button></view>
  <button wx:if="{{!loading && !owner}}" bindtap="login">返回主人登录</button>
  <block wx:if="{{owner && !loading}}">
    <button wx:if="{{hasMore}}" class="small" loading="{{older}}" disabled="{{older}}" bindtap="loadOlder">更早的消息</button>
    <view wx:if="{{!list.length && !error}}" class="empty">写下今天想对你说的话。</view>
    <view wx:for="{{list}}" wx:key="id" class="message {{item.is_me ? 'mine' : ''}}"><view class="muted message-meta">{{item.is_me ? '我' : item.from_name}} · {{item.created_at}}</view><view class="message-body">{{item.content}}</view></view>
    <view class="composer"><textarea maxlength="1000" value="{{draft}}" bindinput="input" placeholder="想对你说…"/><view class="actions"><button class="primary" bindtap="send" loading="{{sending}}" disabled="{{sending || !draft}}">发送</button><text class="muted">{{draft.length}} / 1000</text></view></view>
  </block>
</view>
