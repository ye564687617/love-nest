.message { margin: 24rpx 0; max-width: 94%; }
.message.mine { margin-left: auto; }
.message-meta { font-size: 23rpx; margin-bottom: 8rpx; }
.mine .message-meta { text-align: right; }
.message-body { background:rgba(255,255,255,.96); padding:22rpx; border:1rpx solid rgba(255,107,139,.12); border-radius:28rpx 28rpx 28rpx 6rpx; box-shadow:0 4rpx 16rpx rgba(0,0,0,.04); white-space:pre-wrap; overflow-wrap:break-word; }
.mine .message-body { background:#ffe6ee; border-radius:28rpx 28rpx 6rpx 28rpx; }
.message-meta { color:#655458; text-shadow:0 1rpx 6rpx rgba(255,255,255,.9); }
.composer { margin-top:32rpx; padding:24rpx; border:1rpx solid rgba(255,107,139,.15); background:rgba(255,255,255,.93); border-radius:28rpx; }
.composer textarea { height: 180rpx; }
