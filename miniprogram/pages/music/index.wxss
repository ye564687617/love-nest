.now-playing { text-align:center; padding:40rpx 32rpx 32rpx; border-radius:36rpx; background:rgba(255,255,255,.88); border:1rpx solid rgba(255,230,220,.65); backdrop-filter:blur(14px); box-shadow:0 8rpx 36rpx rgba(200,150,140,.1); }
.record { position:relative; width:340rpx; height:340rpx; border-radius:50%; border:56rpx solid #302b2c; background:repeating-radial-gradient(#302b2c 0 3rpx,#454040 4rpx 6rpx); margin:0 auto 36rpx; box-shadow:0 16rpx 40rpx rgba(93,64,55,.2); }
.cover { display:block; width:100%; height:100%; border-radius:50%; background:#d89486; }
.fallback { padding:50rpx; }
.record-hole { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:38rpx; height:38rpx; background:#fff9f5; border:8rpx solid #eac9bf; border-radius:50%; }
.song-title { margin-bottom: 4rpx; overflow-wrap: break-word; }
.transport { display: flex; justify-content: center; gap: 28rpx; margin-top: 24rpx; }
.transport { align-items:center; }
.transport button { display:flex; align-items:center; justify-content:center; width:80rpx; height:80rpx; padding:22rpx; border:0; border-radius:50%; background:transparent; }
.transport button.play-button { width:100rpx; height:100rpx; background:#e88a7a; box-shadow:0 6rpx 20rpx rgba(200,150,140,.25); }
.transport image { width:100%; height:100%; }
.song-list { margin-top:24rpx; background:rgba(255,255,255,.92); border-radius:28rpx; overflow:hidden; }
.song { padding:24rpx; border-bottom:1rpx solid #f3e7e9; }
.song:last-child { border-bottom:0; }
.song.current { background:rgba(255,107,139,.07); color:#b74765; }
.song-number { width: 48rpx; flex-shrink: 0; color: var(--muted); }
.song-info { flex: 1; min-width: 0; overflow-wrap: break-word; }
.song-info .muted { font-size: 24rpx; }
@media (prefers-reduced-motion:no-preference) { .record-spinning { animation:disc 18s linear infinite; } }
@keyframes disc { to { transform:rotate(360deg); } }
