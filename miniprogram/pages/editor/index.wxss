.editor-form { padding:28rpx; border-radius:32rpx; background:rgba(255,255,255,.94); border:1rpx solid rgba(255,107,139,.15); box-shadow:0 8rpx 24rpx rgba(255,107,139,.08); }
.editor-form .field:first-child { margin-top:0; }
.editor-form .photos { margin-bottom:24rpx; }
.editor-form .photos button { margin-top:8rpx; width:100%; }
.editor-form .actions button { flex:1; }
.lunar-fields { display:grid; grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(0,1fr)); gap:12rpx; }
.lunar-fields input { min-width:0; width:100%; box-sizing:border-box; }
