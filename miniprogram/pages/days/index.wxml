<import src="../../templates/visual.wxml"/>
<template is="background"/>
<view class="page"><view class="page-banner"><view class="title">重要的日子</view><view class="subtitle">每一个值得期待的明天。</view><view class="banner-divider">✿</view><view class="banner-stats"><view class="banner-stat"><image class="icon" src="/assets/days.png"/><text class="banner-number">{{list.length}}</text>个期待</view></view></view>
<button wx:if="{{canDays}}" class="primary small" data-module="countdowns" bindtap="edit">记个日子</button>
<view wx:if="{{loading}}" class="skeleton"></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{!loading && !error && !list.length}}" class="empty"><image class="empty-mark" src="/assets/days.png"/>{{owner ? '还没有记录重要日子。' : '暂时没有公开的纪念日。'}}</view>
<view wx:if="{{!error}}" class="days-grid"><view wx:for="{{list}}" wx:key="id" class="day-card"><view class="row"><image class="icon" src="/assets/days.png"/><text class="day-kind">{{item.kind === 'birthday' ? '生日' : item.kind === 'festival' ? '节日' : item.kind === 'anniversary' ? '纪念日' : '倒计时'}}</text></view><view class="day-title">{{item.title}}</view><view wx:if="{{item.birthday_label}}" class="hint">{{item.birthday_label}}</view><view class="day-date">{{item.next_date || item.target_date}}</view><view class="day-count"><text>{{item.days < 0 ? -item.days : item.days}}</text><view>天</view></view><view class="day-label">{{item.label}}</view><view wx:if="{{item.age !== null}}" class="hint">即将 {{item.age}} 岁</view><button wx:if="{{canDays}}" class="small" data-module="countdowns" data-item="{{item}}" bindtap="edit">编辑</button></view></view>
</view>
