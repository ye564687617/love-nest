.wish { flex:1; min-width:0; overflow-wrap:break-word; }
.done { color:var(--muted); text-decoration:line-through; }
.edit-wish { margin-top:16rpx; }
.progress-panel .section-title { margin-bottom:12rpx; font-size:28rpx; }
.progress-panel > button { margin-top:20rpx; }
.progress-track { height:16rpx; background:rgba(255,107,139,.12); border-radius:16rpx; overflow:hidden; }
.progress-fill { height:100%; border-radius:16rpx; background:linear-gradient(90deg,#ff6b8b,#ff9eb5); }
.wish-item { padding:24rpx; margin-bottom:16rpx; border-radius:24rpx; background:rgba(255,255,255,.95); border:1rpx solid rgba(0,0,0,.05); box-shadow:0 4rpx 16rpx rgba(0,0,0,.04); }
.wish-check { width:42rpx; height:42rpx; border:2rpx solid #ffd0dc; border-radius:50%; flex-shrink:0; color:#c75170; display:flex; align-items:center; justify-content:center; font-size:26rpx; }
.completed { border-color:rgba(78,205,196,.25); background:rgba(247,255,254,.96); }
.completed .wish-check { background:#4ecdc4; color:#fff; border-color:#4ecdc4; }
.wish-status { font-size:21rpx; color:#a16b78; flex-shrink:0; }
.completed .wish-status { color:#23877e; }
