<import src="../../templates/visual.wxml"/>
<template is="background"/>
<view class="page"><view class="page-banner"><view class="title">恋爱清单</view><view class="subtitle">和你一起，把想做的事变成回忆。</view><view class="banner-divider">✿</view><view class="banner-stats"><view class="banner-stat"><text class="banner-number">{{list.length}}</text>个心愿</view><view class="banner-stat"><text class="banner-number">{{done}}</text>已完成</view><view class="banner-stat"><text class="banner-number">{{list.length - done}}</text>待完成</view></view></view>
<view class="panel progress-panel"><view class="row"><text class="section-title">我们的完成进度</text><text class="tag">{{percent}}%</text></view><view class="progress-track"><view class="progress-fill" style="width:{{percent}}%"></view></view><view class="hint">已经一起完成 {{done}} / {{list.length}} 件小事</view><button wx:if="{{canChecklist}}" class="primary small" data-module="lovelist" bindtap="edit">添个心愿</button></view>
<view class="tabs"><button class="{{filter === 'all' ? 'selected' : ''}}" data-value="all" bindtap="filter">全部</button><button class="{{filter === '0' ? 'selected' : ''}}" data-value="0" bindtap="filter">想一起做</button><button class="{{filter === '1' ? 'selected' : ''}}" data-value="1" bindtap="filter">已经完成</button></view>
<view wx:if="{{loading}}" class="skeleton"></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{!loading && !error && !visible.length}}" class="empty">这里还没有心愿。</view>
<view wx:if="{{!error}}" wx:for="{{visible}}" wx:key="id" class="wish-item {{item.done == 1 ? 'completed' : ''}}"><view class="row"><view class="wish-check">{{item.done == 1 ? '✓' : '♡'}}</view><view class="wish {{item.done == 1 ? 'done' : ''}}">{{item.title}}</view><button wx:if="{{canChecklist}}" class="small" data-item="{{item}}" bindtap="toggle">{{item.done == 1 ? '撤销完成' : '完成'}}</button><text wx:else class="wish-status">{{item.done == 1 ? '已完成' : '待完成'}}</text></view><button wx:if="{{canChecklist}}" class="small edit-wish" data-module="lovelist" data-item="{{item}}" bindtap="edit">编辑心愿</button></view>
</view>
