<import src="../../templates/visual.wxml"/>
<template is="background"/>
<view class="page">
  <view class="page-banner"><view class="title">情侣小游戏</view><view class="subtitle">让平凡的日常，多一点心动。</view><view class="banner-divider">✿</view></view>
  <view wx:if="{{loading}}" class="skeleton"></view>
  <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{!owner}}" bindtap="onShow">重试</button></view>
  <view wx:if="{{!loading && !owner}}" class="game-previews"><view class="game-preview"><image src="/assets/games.png"/><view><view class="game-title">幸运骰子</view><view class="muted">比比今天谁的运气更好</view></view></view><view class="game-preview"><image src="/assets/days.png"/><view><view class="game-title">约会转盘</view><view class="muted">一起决定吃什么、去哪里</view></view></view><view class="game-preview"><image src="/assets/heart.png"/><view><view class="game-title">默契问答</view><view class="muted">看看你们有多了解彼此</view></view></view><button class="primary" bindtap="login">主人登录后开始</button></view>
  <block wx:if="{{owner && !loading}}">
    <view wx:if="{{!mode}}" class="game-list"><button data-mode="dice" bindtap="choose"><image src="/assets/games.png"/><view class="game-title">幸运骰子</view><view class="muted">比比今天谁的运气更好</view></button><button data-mode="wheel" bindtap="choose"><image src="/assets/days.png"/><view class="game-title">约会转盘</view><view class="muted">一起决定吃什么、去哪里</view></button><button data-mode="quiz" bindtap="choose"><image src="/assets/heart.png"/><view class="game-title">默契问答</view><view class="muted">看看你们有多了解彼此</view></button></view>
    <button wx:if="{{mode}}" class="small section" bindtap="back">返回游戏列表</button>
    <view wx:if="{{mode === 'dice'}}" class="section game-surface">
      <view class="section-title">幸运骰子</view><view class="scores"><view>玩家一<view class="dice {{busy && turn === 0 ? 'rolling' : ''}}">{{dice[0] || '?'}}</view></view><view>玩家二<view class="dice {{busy && turn === 1 ? 'rolling' : ''}}">{{dice[1] || '?'}}</view></view></view>
      <view class="result">{{finished ? result : (turn === 0 ? '玩家一的回合' : '玩家二的回合')}}</view>
      <button wx:if="{{!finished}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="roll">投掷</button><button wx:else class="primary" bindtap="again">再来一局</button>
    </view>
    <view wx:if="{{mode === 'wheel'}}" class="section game-surface wheel-surface">
      <view class="section-title">约会转盘</view><view class="actions"><button class="small {{wheelType === 'food' ? 'primary' : ''}}" data-type="food" disabled="{{busy}}" bindtap="wheelType">吃什么</button><button class="small {{wheelType === 'play' ? 'primary' : ''}}" data-type="play" disabled="{{busy}}" bindtap="wheelType">去哪里</button><button class="small {{wheelType === 'custom' ? 'primary' : ''}}" data-type="custom" disabled="{{busy}}" bindtap="wheelType">自定义</button></view>
      <view wx:if="{{wheelType === 'custom'}}" class="field"><textarea value="{{custom}}" bindinput="input" disabled="{{busy}}" maxlength="180" placeholder="每行一个选项"/><button class="small" disabled="{{busy}}" bindtap="applyCustom">应用选项</button></view>
      <view class="wheel-wrap" style="width:{{wheelSize}}px;height:{{wheelSize}}px"><view class="pointer">▼</view><canvas canvas-id="wheel" class="wheel" style="width:{{wheelSize}}px;height:{{wheelSize}}px;transform:rotate({{rotation}}deg)"/></view>
      <view class="options"><text wx:for="{{options}}" wx:key="index">{{index + 1}}. {{item}}　</text></view>
      <view class="result">{{result}}</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="spin">转一下</button>
      <view wx:if="{{history.length}}" class="section"><view class="section-title">最近的选择</view><view wx:for="{{history}}" wx:key="index" class="muted">{{item}}</view></view>
    </view>
    <view wx:if="{{mode === 'quiz'}}" class="section game-surface">
      <view class="section-title">默契问答</view>
      <block wx:if="{{!finished && question}}"><view class="muted">第 {{questionIndex + 1}} / {{total}} 题 · 玩家{{player === 0 ? '一' : '二'}}</view>
        <view class="question">{{question.question}}</view>
        <view wx:if="{{revealed && player === 0}}" class="empty">答案已收好，把手机交给另一位。</view>
        <view wx:else class="answers"><button wx:for="{{question.options}}" wx:key="index" class="{{selected === index ? 'primary' : ''}}" data-index="{{index}}" disabled="{{revealed}}" bindtap="answer">{{item}}</button></view>
        <view class="result">{{result}}</view><button wx:if="{{revealed}}" class="primary" bindtap="nextQuestion">{{player === 0 ? '另一位准备好了' : '继续'}}</button>
      </block>
      <block wx:if="{{finished}}"><view class="quiz-score">{{percent}}%</view><view class="result">{{total}} 题里，有 {{matches}} 题选择相同</view><button class="primary" bindtap="again">再测一次</button></block>
    </view>
  </block>
</view>
