.game-list, .answers { display: flex; flex-direction: column; gap: 20rpx; margin-top: 32rpx; }
.scores { display: flex; justify-content: space-around; text-align: center; margin: 40rpx 0; }
.dice { width: 150rpx; height: 150rpx; line-height: 150rpx; background: var(--surface); border: 2rpx solid var(--accent); border-radius: 16rpx; color: var(--accent); font-size: 72rpx; margin-top: 20rpx; }
.rolling { animation: shake .18s linear infinite; }
@keyframes shake { 50% { transform: rotate(14deg); } }
.result { text-align: center; min-height: 64rpx; margin: 28rpx 0; font-weight: 600; overflow-wrap: break-word; }
.wheel-wrap { width: 300px; max-width: 100%; height: 300px; position: relative; margin: 40rpx auto 16rpx; }
.wheel { width: 300px; height: 300px; max-width: 100%; transition: transform 2.2s cubic-bezier(.16,.8,.22,1); }
.pointer { position: absolute; top: -14rpx; left: 50%; transform: translateX(-50%); z-index: 2; color: #ff6b8b; font-size: 42rpx; }
.options { color: var(--muted); font-size: 24rpx; overflow-wrap: break-word; }
.question { font-size: 34rpx; font-weight: 600; margin: 32rpx 0; }
.quiz-score { font-size: 96rpx; text-align: center; color: var(--accent); }
.game-list button,.game-preview { background:rgba(255,255,255,.95); border-radius:32rpx; padding:36rpx; border:1rpx solid rgba(255,107,139,.15); box-shadow:0 8rpx 32rpx rgba(255,107,139,.1); }
.game-list button { width:100%; padding:44rpx 32rpx; }
.game-list image { width:96rpx; height:96rpx; margin-bottom:16rpx; }
.game-title { font:700 34rpx var(--serif); color:#5d4037; }
.game-list .muted,.game-preview .muted { font-size:24rpx; margin-top:10rpx; }
.game-previews { display:flex; flex-direction:column; gap:20rpx; }
.game-preview { display:flex; align-items:center; gap:28rpx; }
.game-preview image { width:72rpx; height:72rpx; flex-shrink:0; }
.game-preview > view { min-width:0; }
.game-previews > button { margin-top:8rpx; }
.game-surface { background:rgba(255,255,255,.95); border-radius:32rpx; padding:28rpx; border:1rpx solid rgba(255,107,139,.15); box-shadow:0 8rpx 24rpx rgba(255,107,139,.1); }
.wheel-surface { padding-left:12rpx; padding-right:12rpx; }
